{
    // Section 9.5 of openspec/changes/local-stack/tasks.md.
    //
    // Excluding these from the editor's file watcher is the same fix as
    // `--reload-dir app` in the Makefile, applied to a different watcher. Without
    // it, installing a package into venv/ adds a watch per file, the editor hits
    // its inotify limit, and the symptom appears later and looks unrelated to the
    // install that caused it.
    //
    // Relative globs, matching VS Code's watcherExclude syntax.
    "files.watcherExclude": {
        "**/venv/**": true,
        "**/.pytest_cache/**": true,
        "**/__pycache__/**": true,
        "**/.ruff_cache/**": true,
        "**/.mypy_cache/**": true,
        "**/*.pyc": true
    },
    "search.exclude": {
        "**/venv": true,
        "**/.pytest_cache": true,
        "**/__pycache__": true
    },
    "python.testing.pytestArgs": ["tests"],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "python.analysis.extraPaths": ["${workspaceFolder}"],
    "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python"
}
