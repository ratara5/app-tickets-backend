# ============================================================
# Backend environment template
# Copy to .env (git-ignored) and fill every REQUIRED value.
# Every key below is read by app/core/settings.py. A missing
# required key aborts the process at import time with a
# pydantic ValidationError, so keep this file complete.
#
# Format rules (they are not cosmetic):
#   - No spaces around "=" (breaks `set -a; . ./.env` and systemd
#     EnvironmentFile parsing).
#   - No inline comments (the value would include the comment).
#   - Quote only when the value itself needs it.
# ============================================================

# ---------- Company (client) ----------
COUNTRY=CO
TZ_COMPANY=America/Bogota
CLIENT_COMPANY_NAME=CLIENT_LEGAL_NAME
CLIENT_FORMAT_NAME=CLIENT_SHORT_NAME

# ---------- Company (contractor) ----------
CONTRACTOR_NAME=CONTRACTOR_LEGAL_NAME
CONTRACTOR_NIT=901719606-9
CONTRACTOR_CONTACT=CONTRACTOR_CONTACT_NAME
CONTRACTOR_PHONE=3000000000

# ---------- Public domains (Caddy) ----------
# Only needed by the deployment stack (infra/vps/docker-compose.yml passes
# them to Caddy), NOT by app/core/settings.py. API_DOMAIN serves the REST API;
# MEDIA_DOMAIN serves MinIO objects through Caddy and is the value that belongs
# in MINIO_PUBLIC_ENDPOINT below. Both must be resolvable by the mobile app.
# (A scripts/preflight.sh used to be referenced here; it does not exist in this
# tree. The equivalent gate is §5.5/§5.6 of docs/deployment-guide.md.)
API_DOMAIN=api.example.com
MEDIA_DOMAIN=media.example.com
# Passed to Caddy for the ACME account; ACME zero-issue lets the
# address be omitted entirely, so a placeholder is acceptable here.
ACME_EMAIL=ops@example.com

# ---------- PostgreSQL ----------
# Host run locally: localhost + published host port.
# Backend in Docker on the shared network: the container name and the
# in-container port (docker DNS only resolves inside a network).
DB_HOST=postgres-gci
DB_PORT=5432
DB_NAME=db_gestiket_acme
# The least-privilege runtime role, created by
# infra/provision/001-create-application-roles.sql. It holds DML on this
# database's 17 modelled tables and owns nothing: no superuser, no CREATEDB,
# no CREATED ROLE, no ownership, and no privilege at all on the five reserved
# tables (hollidays, materials, preliquidated, services, uom) or on
# alembic_version. Never `postgres`, and never the owner of the database.
# Migrations are run by a human as the schema's owner, not by this credential;
# infra/vps/docker-compose.yml's `migrate` job takes an elevated DB_USER and
# DB_PASSWORD explicitly, precisely so this value stays low-privilege.
DB_USER=gestiket_app
DB_PASSWORD=GENERATE_WITH_OPENSSL_RAND_BASE64_32

# ---------- MinIO (S3 object storage) ----------
# TWO origins, TWO jobs. Never one value for both.
#
# MINIO_ENDPOINT (internal dial target) is where THIS PROCESS reaches the
# object store. It must be an address the backend can resolve, so it is NOT a
# public identity and NOT a LAN address:
#   backend on the host .................. 127.0.0.1
#   backend in Docker (acme network) ..... minio-acme
# A DHCP lease here is a latent outage: when the lease moves, every upload dies.
MINIO_ENDPOINT=minio-acme
MINIO_PORT=9000
MINIO_SECURE=false
#
# MINIO_PUBLIC_ENDPOINT is the origin baked into every pre-signed URL, i.e. the
# host the MOBILE APP must resolve to load a photo. The SigV4 signature covers
# the Host header, so it is chosen at signing time and the URL is NEVER
# rewritten afterwards: swapping the host in a delivered URL returns
# 403 SignatureDoesNotMatch. It must therefore be stable - a domain, or a DHCP
# reservation - and never a bare lease.
#   VPS ................................. media.example.com (Caddy), 443, TLS
#   LAN (stopgap only) .................. the machine LAN address
# When unset, it falls back to MINIO_ENDPOINT, so a single-value configuration
# keeps behaving exactly as before.
MINIO_PUBLIC_ENDPOINT=media.example.com
# Public port and scheme, when they differ from the internal ones
# (the VPS case: public 443/TLS, internal 9000/plain). Default to the
# internal values when omitted.
MINIO_PUBLIC_PORT=443
MINIO_PUBLIC_SECURE=true
# SigV4 region. Pinning it keeps pre-signing local: without it minio-py issues
# GET /{bucket}?location= against the PUBLIC host on every pre-signed URL.
# MinIO's own default is us-east-1; set it if your MinIO was started with
# MINIO_REGION set to something else.
MINIO_REGION=us-east-1
# Bucket dedicated to this app (one bucket per app on shared MinIO).
MINIO_DEFAULT_BUCKET=acme-uploads
# Credentials of a service account whose policy is scoped to
# MINIO_DEFAULT_BUCKET only. Never MinIO root credentials.
#
# The secret is an instruction, not a value. Anything that merely LOOKS like a
# credential - a 44-character base64 string - is indistinguishable from a real
# one to the next reader, and gets shipped. Generate it into the git-ignored .env:
#   openssl rand -base64 32
MINIO_ACCESS_KEY=app_tickets
MINIO_SECRET_KEY=<openssl rand -base64 32>
BASE_OBJECT_PATH=Mantenimientos/Correctivos
EXT_BY_TYPE=image/jpeg:.jpg,image/png:.png,image/webp:.webp,application/pdf:.pdf,image/svg+xml:.svg
ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf,image/svg+xml
# Pre-signed URL lifetime. The unit is in the name: get_presigned_url takes a
# timedelta, and every call site multiplies this by hours.
PRESIGNED_TTL_HOURS=1

# ---------- Worksheets / disk ----------
# Relative to the process working directory, so the same value works
# for a host run and inside the container. worksheet_service.py
# falls back to the package path if this directory does not exist.
TEMPLATES_DIR=app/templates/reports
PDF_SUFFIX=Soporte
# Staging directory for chunked uploads. Mount it on a volume when
# the API runs in Docker or an in-flight upload is lost on restart.
CHUNK_DIR=/tmp/upload_chunks

# ---------- Auth ----------
# Generate into the git-ignored .env:  openssl rand -base64 48
JWT_SECRET=<openssl rand -base64 48>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ==============================================================================
# LOCAL DEVELOPMENT
# ==============================================================================
#
# THIS FILE IS THE TEMPLATE. `.env` is the file that is read, and it is
# git-ignored. The file name is the same in both environments on purpose: one
# resolution path, one key namespace, one place to look. Only the VALUES below
# differ. Anything that is not listed as different here is identical in both.
#
# Every local value below was READ FROM a declaration, not chosen here. Where a
# value was copied, the comment names the declaration it came from and the project
# that owns that declaration. A copied value without its provenance is the second
# place the same setting can drift, which is exactly the failure a shared core
# already demonstrates: a container that came back on a different network because
# the two declarations were updated apart.
#
# The two local value sets, and when each applies:
#
#   NATIVE (host) mode  - the API process runs on your machine, so it reaches the
#                         core over published loopback ports. These are the values
#                         in this section.
#   DOCKER mode         - the API runs in a container attached to this project's
#                         own network, where the core's containers are reachable
#                         BY CONTAINER NAME. Those values are supplied by
#                         infra/local/docker-compose.yml and are NOT set here,
#                         because a container must never be told to dial a
#                         loopback address it cannot use.
#
# ------------------------------------------------------------------------------
# PORTS - both sets, side by side, so neither is mistaken for the other
# ------------------------------------------------------------------------------
#
#   Dependency   Setting          Native (host)   In-container   VPS
#   -----------  ---------------  --------------  -------------  --------------
#   PostgreSQL   DB_PORT          5435            5432           5432
#   PostgreSQL   DB_HOST          127.0.0.1       postgres-gci   postgres-gci
#   Object store MINIO_PORT       9000            9000           9000
#   Object store MINIO_ENDPOINT   127.0.0.1       minio-acme     minio-acme
#
#   Read from the core's own declarations, and PINNED to the exact bytes read:
#
#     - PostgreSQL published port: the core's PostgreSQL compose file declares
#       `127.0.0.1:5435:5432` (host 5435 -> container 5432).
#       source: /home/ratara5/Documents/GoogleCloudProjects/core/compose.yml
#       content hash of the file read: c6e318d2bd92
#     - Object store published ports: the core's object store compose file
#       declares `127.0.0.1:9000:9000` (API) and `127.0.0.1:9001:9001` (console).
#       source: /home/ratara5/Documents/GoogleCloudProjects/gci-companies/gci-empresa-a/assync/docker-compose.yml
#       content hash of the file read: 37658ddd7fa7
#
#   WHY A CONTENT HASH AND NOT A COMMIT SHA. A commit sha is what you want when the
#   source is committed and clean. Neither of these is:
#
#     - the PostgreSQL declaration has uncommitted local modifications, so its HEAD
#       (`ac04a45`) is NOT the file that was read (`c6e318d2bd92`);
#     - the object store declaration is not tracked by that repository at all, so no
#       commit sha exists for it.
#
#   Recording either would have been a precise-looking lie: a sha that reads as "this
#   value came from this exact revision" while pinning something else. `git hash-object`
#   hashes the bytes actually read, so it is true in both cases. `make gate` recomputes
#   it and reports drift; when the source is not present on the machine it reports that
#   it could not verify, rather than passing silently.
#
#   The in-container column is byte-identical to the VPS column, because that is
#   the point: in both environments the API dials the container name on a network.
#   The only difference between local and production is the published loopback
#   port a host-side process needs, and that difference exists only because native
#   mode runs outside the network.
#
# ------------------------------------------------------------------------------
# Local values
# ------------------------------------------------------------------------------

# Loopback: native mode reaches the core's published port from your machine.
# In docker mode, infra/local/docker-compose.yml overrides this with the core's
# container name, because a container on this project's network cannot use 127.0.0.1.
# Provenance: the core's PostgreSQL compose file publishes 5435 -> 5432.
DB_HOST=127.0.0.1
# Provenance: the same declaration, container port.
DB_PORT=5435

# Provenance: the core's object store compose file publishes 9000 -> 9000.
# Overridden to the container name in docker mode.
MINIO_ENDPOINT=127.0.0.1
# Provenance: the same declaration.
MINIO_PORT=9000
# The core terminates TLS at its edge, not at the object store, so the store is
# reached in plain HTTP inside the network. Same on VPS - see
# infra/vps/docker-compose.yml:88, where MINIO_SECURE is false for the same reason.
MINIO_SECURE=false

# The origin baked into pre-signed URLs. This is NOT where the API dials; it is
# what a browser will dial, so it must be reachable from the machine holding the
# URL. Locally no TLS edge terminates anything, so the origin is the published
# loopback API port. VPS uses the media domain on 443 with TLS, read from
# infra/vps/docker-compose.yml:93-95.
# Without this, a URL signed for `minio-acme` is a URL the host cannot resolve.
MINIO_PUBLIC_ENDPOINT=127.0.0.1
# Provenance: the core's object store compose file, published API port.
MINIO_PUBLIC_PORT=9000
# No TLS locally - see above.
MINIO_PUBLIC_SECURE=false

# Same value in both environments, and the same in a host run and a container run:
# relative to the process working directory, so it resolves the same either way.
# worksheet_service.py falls back to the package path if this directory is absent.
TEMPLATES_DIR=app/templates/reports
# Staging for chunked uploads. Disposable by definition - a lost chunk is a lost
# upload the client can retry, not a lost record. No volume is mounted for it;
# infra/local/docker-compose.yml mounts nothing.
CHUNK_DIR=/tmp/upload_chunks

# ------------------------------------------------------------------------------
# NETWORKS
# ------------------------------------------------------------------------------
#
# Local (this project's own, declared and created by this repository):
#   app-tickets-local-net      infra/local/docker-compose.yml
#
# The core's containers are attached to that network by `make setup-local`, after
# being confirmed already running, and detached by `make local-down`. This
# repository never starts, stops, restarts or removes them: they belong to the
# project that operates the core.
#
# VPS (read from infra/vps/docker-compose.yml:206-209, which is the declaration of
# record for it): one external network that Caddy, api, migrate and both
# dependencies share. That name is deliberately not repeated here - it belongs to
# the deployed stack's own file, and this project does not depend on it locally.
#
# ------------------------------------------------------------------------------
# THE CORE - a configured input, not an assumption
# ------------------------------------------------------------------------------
#
# The core is owned, configured and started by the project that operates it. This
# repository consumes it and does not manage it. The value below is the bring-up
# command or compose file for that project, kept here so this repository can ask
# for it and quote it in an error message.
#
# IT IS INTENTIONALLY EMPTY. Leaving it empty is the correct state on a machine
# where the core is already running, and the local stack does not need to start it.
# `make setup-local` refuses to guess a path and fails naming this key.
#
# Set it only to read the core's state, never to start it:
CORE_COMPOSE_COMMAND=

# The core's ADMINISTRATIVE credential, used only to provision this project's role,
# database and bucket. Same reasoning as the key above: it is owned by the project
# that operates the core, it is set here only so this repository can ask for it, and
# `make setup-local` fails naming this key rather than guessing.
#
# It is NOT the runtime DB_USER/DB_PASSWORD above, and must not be set to them. The
# provisioning role can create a database; the application role cannot. Reusing one
# credential for both would mean the running service holds rights it has no use for.
CORE_DB_ADMIN_USER=
CORE_DB_ADMIN_PASSWORD=

# The core's object-store administrative credential, used only to create this
# project's bucket and object-store user. Same reasoning as the keys above: the
# core owns it, this repository only asks for it, and setup-local fails by name
# rather than guessing. Never set these to MINIO_ACCESS_KEY/MINIO_SECRET_KEY,
# which are this project's own scoped credential, not an administrator's.
CORE_MINIO_ROOT_USER=
CORE_MINIO_ROOT_PASSWORD=

# ---------- Local verification (make gate-local) -----------------------------
# `make gate-local` drives the real API and deletes everything it creates. It
# needs an account in this project's database, and the ids of a row the seeded
# reference data provides, because the ticket route requires them.
#
# The local account. `make setup-local` creates it from these values, hashing
# SEED_USER_PASSWORD with a fresh salt on every run; `make gate-local` then logs in
# with the same pair. One account, one set of keys — the gate does not keep its own
# copy, and does not register a user of its own, because a gate that creates an
# account writes to the database every time it runs.
#
# SEED_USER_ID is fixed because infra/local/seed/technicians.csv references it, and
# a CSV committed here cannot know a generated id.
SEED_USER_ID=9001
SEED_USER_NAME=Local Seed User
SEED_USER_ROLE=admin
# The address must be one the application's own validator accepts. A reserved
# TLD is rejected: `local-seed@example.invalid` fails login with
# "value is not a valid email address ... special-use or reserved name", which
# reads as a missing account rather than as a rejected address. example.com is
# reserved for documentation, so it can never reach a real mailbox.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
GATE_SEED_TICKET_ID=
GATE_SEED_MARKET_ID=
GATE_SEED_EQUIPMENT_ID=
