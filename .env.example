COUNTRY=CODE
TZ_COMPANY=Continent/City

DB_NAME=db_name

MINIO_ENDPOINT=minio_container_name
MINIO_PORT=9005
MINIO_ACCESS_KEY=your_key
MINIO_SECRET_KEY=your_secret
MINIO_SECURE=true
MINIO_DEFAULT_BUCKET=company_bucket
BASE_OBJECT_PATH=Base/Path
EXT_BY_TYPE={"image/webp":".webp","application/pdf":".pdf","image/svg+xml":".svg"}
ALLOWED_TYPES = ["image/webp","application/pdf","image/svg+xml"]
PRESIGNED_TTL=1000  # Time in seconds

TEMPLATES_DIR=/path/to/your/templates/reports
PDF_SUFFIX=Suffix

DB_HOST=db_container_name
DB_PORT=5435
DB_USER=your_db_user
DB_PASSWORD=your_db_password

CHUNK_DIR=/tmp/uploads_chunks

JWT_SECRET=your_jwt_key
JWT_ALGORITHM="ALGORITHM"
JWT_EXPIRE_MINUTES=10